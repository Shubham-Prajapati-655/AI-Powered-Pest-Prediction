# ==============================================================================
# AgriAI Platform - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_NAME=AgriAI Advisor
APP_VERSION=v2.1.0
APP_ENV=production
DEBUG=False

# Application Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Supported schemes:
# SQLite (default for development):
DATABASE_URL=sqlite:///database/predictions.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://agri_user:secure_password@localhost:5432/agri_db
# MySQL:
# DATABASE_URL=mysql://agri_user:secure_password@localhost:3306/agri_db
DB_POOL_SIZE=5
DB_TIMEOUT_SECONDS=10

# Default Administrator Credentials (Seeded on first launch if not present)
ADMIN_EMAIL=admin@agriai.org
ADMIN_DEFAULT_PASSWORD=Admin@12345

# Authentication & Session Security
SESSION_TIMEOUT_MINUTES=1440
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=2

# Weather API Configuration
WEATHER_API_TIMEOUT=5
WEATHER_API_RETRIES=3
WEATHER_CACHE_TTL_SECONDS=600

# Logging & Auditing
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Storage & Upload Limits
MAX_AVATAR_SIZE_MB=2

# Optional SMTP Mail Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
